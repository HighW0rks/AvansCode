@page "/assignment"
@rendermode InteractiveServer
@inject InfluxMeasurementRepository measurementRepository;
@inject SmartMeterConfiguration smartMeterConfiguration;

<!-- Dit wordt gebruik voor het ophalen van de API-->
@using System.Net.Http
@using System.Net.Http.Headers
@using System.Text.Json

<!-- Algemeen HTML code-->
<PageTitle>Opdracht F</PageTitle>

<h1>Opdracht F gemaakt door Bas Rijken</h1>

<p class="text-paragraaf">
    Welkom op deze pagina van mijn project. Hier is van alles te zien, zoals een datumprikker, grafiek, tekstvelden en een tabel.
    Eerst zal ik kort de opdracht toelichten.
</p>

<p class="text-paragraaf">
    Het doel van deze opdracht is om met behulp van een algoritme een laadsessie van je EV (Elektrisch Voertuig) te detecteren en te vergelijken of deze goedkoper zou zijn geweest met een vast energietarief of een dynamisch energietarief van Vattenfall.
</p>

<p class="text-paragraaf">
    Nu leg ik uit wat je op deze pagina ziet.
</p>

<p class="text-paragraaf">
    Onder deze tekst bevindt zich een datumprikker, een belangrijk onderdeel van het algoritme.
    Bij het selecteren van een datum wordt data geladen vanaf dat moment tot vandaag. Alleen het tijdstip en het verbruik in Watt worden gebruikt.
    Hoe meer dagen je selecteert, hoe langer het duurt voordat alles is geladen. Heb daarom even geduld. De data is tot op één minuut nauwkeurig.
</p>

<p class="text-paragraaf">
    Onder de datumprikker staat een grafiek. Hier kun je visueel zien op welke momenten hoeveel Wattage gebruikt of geproduceerd wordt.
    Positieve waarden geven verbruik weer, negatieve waarden zijn opbrengst van zonnepanelen.
</p>

<p class="text-paragraaf">
    Onder de grafiek staan twee tekstvelden. Hierin worden het vaste energieprijs per kWh en de laadsessie-detectiewaarden in Watt weergegeven.
    Deze velden kunnen worden aangepast om ongewenst verbruik als laadsessie van je EV te markeren of om de prijs per Watt aan te passen.
</p>

<p class="text-paragraaf">
    Daaronder staat een tabel. In deze tabel worden de laadsessies geregistreerd met starttijd, stoptijd, verbruik in kWh, kosten bij vaste prijzen en kosten bij dynamische energietarieven.
</p>

<p class="text-paragraaf">
    Hoe werkt het systeem? Elke keer dat je de website bezoekt, wordt via de API van Vattenfall data opgehaald over dynamische energietarieven. Deze data wordt opgeslagen en verder verwerkt.
    Data van vandaag wordt automatisch opgehaald en weergegeven in de tabel.
    Wanneer er een piek is boven de detectiewaarden, wordt dit geregistreerd als een laadsessie in de tabel.
    Door de datumprikker te gebruiken, wordt opnieuw data opgehaald en verwerkt.
    Als je de prijzen of het detectievermogen aanpast, wordt dit direct doorgevoerd in de laadsessies-tabel.
</p>

<p class="text-paragraaf">
    Met dit systeem kun je precies zien hoeveel je per laadsessie verbruikt en wat de kosten zijn geweest bij een vast energiecontract of een dynamisch energiecontract.
</p>

<!--Dit zijn elementen die gebruikt worden in de website-->
<MudDatePicker Label="Select date" 
               DateChanged=OnDateChanged
               MaxDate="@DateTime.Today" 
               Clearable="false" 
               Variant="Variant.Outlined" />

<MudPaper Class="doc-section-component-container">    
    <MudChart ChartType="ChartType.Line"
              ChartSeries="@_series"
              @bind-SelectedIndex="_index"
              XAxisLabels="@_xAxisLabels"
              Width="@_width"
              Height="@_height"
              ChartOptions="@_options"
              AxisChartOptions="_axisChartOptions" />
</MudPaper>

<div class="input-fields">
    <div class="input-field">
        <MudTextField @bind-Value="wattAmount" Label="Detectie Aantal" Variant="Variant.Outlined" Adornment="Adornment.End" AdornmentText="Watt" Immediate="true" OnBlur="OnAmountChanged" />
    </div>
    <div class = "input-field">
        <MudTextField @bind-Value="prijskWhText" label="Prijs per kWh" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Euro" Immediate="true" OnBlur="OnPriceChanged" />
    </div>
</div>

<MudPaper Class="mt-8 pa-4">
    <MudText Typo="Typo.h6">Laadsessies</MudText>
    <MudTable Items="laadSessies" Hover="true" Dense="true" Bordered="true" Striped="true">
        <HeaderContent>
            <MudTh>Starttijd</MudTh>
            <MudTh>Eindtijd</MudTh>
            <MudTh>Verbruik (kWh)</MudTh>
            <MudTh>Kosten (€)</MudTh>
            <MudTh>Dynamisch Kosten (€)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Start tijd">@context.StartTime.ToString("dd-MM-yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Eind tijd">@context.StopTime.ToString("dd-MM-yyyy HH:mm")</MudTd>
            <MudTd DataLabel="Verbruik (kWh)">@Math.Round(context.Value, 2)</MudTd>
            <MudTd DataLabel="Kosten (€)">@Math.Round(context.Value * (context.Price), 2)</MudTd>
            <MudTd DataLabel="Dynamisch Kosten (€)">@Math.Round(context.TariffPrice, 2)</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText class="pa-4">Geen laadsessies gevonden voor deze datum.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>


@code {
    class GebruikteData
    {
        public DateTime StartTime { get; set; }
        public DateTime StopTime { get; set; }
        public decimal Value { get; set; }
        public decimal Price { get; set; }
        public decimal TariffPrice { get; set; }
    }

    class DetailsEnergie
    {
        public decimal amountExclVat { get; set; }
        public decimal amountInclVat { get; set; }
        public string? type { get; set; }
    }

    class DynamischEnergie
    {
        public DateTime startTime { get; set; }
        public DateTime endTime { get; set; }
        public bool isMissingPeriod { get; set; }
        public bool cheapestOfDay { get; set; }
        public decimal amountInclVat { get; set; }
        public decimal amountExclVat { get; set; }
        public List<DetailsEnergie>? details { get; set; }
    }

    class DynamischEnergieData
    {
        public List<DynamischEnergie>? tariffData { get; set; }
    }

    // Alle lijsten
    private List<Measurement>? measurements;
    private List<double> data = new();
    private List<ChartSeries> _series = new();
    private List<decimal> verbruiktAuto = new();
    private List<decimal> verbruiktAutoDynamisch = new();
    private List<GebruikteData> laadSessies = new();
    private List<DynamischEnergie>? UurTarieven = new();

    // Datum variable
    private DateTime? _selectedDate = DateTime.Today;

    // Basis variable
    private double? wattAmount = 3500;
    private string? prijskWhText = "0,25";
    private decimal? prijskWh = 0.25m;

    // variable en optie voor de grafiek
    private int _index = -1;
    private ChartOptions _options = new ChartOptions
    {   
        InterpolationOption = InterpolationOption.Straight,
        LineStrokeWidth = 1
    };
    private AxisChartOptions _axisChartOptions = new AxisChartOptions
    {
        MatchBoundsToSize = true
    };
    private string _width = "1000px";
    private string _height = "350px";
    private string[] _xAxisLabels = Array.Empty<string>();


    protected override void OnInitialized()
    {
        OphalenDynamischEnergie();
        GrafiekLaden();
    }

    // Methode om de gegevens van de API op te halen
    private async void OphalenDynamischEnergie()
    {
        var url = "https://api-acc.vattenfall.nl/api/vfnl/consumptions/v1/DynamicTariff";

        using HttpClient client = new();
        client.DefaultRequestHeaders.Clear();
        client.DefaultRequestHeaders.Add("Ocp-Apim-Subscription-Key", "4bfcc75549d04d2b8e8b94aebe67614f");
        client.DefaultRequestHeaders.Add("Origin", "https://www.vattenfall.nl");
        client.DefaultRequestHeaders.Accept.Add(new MediaTypeWithQualityHeaderValue("application/json"));

        try
        {
            var response = await client.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                string json = await response.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<List<DynamischEnergieData>>(json, new JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                });

                if (data != null)
                {
                    UurTarieven = data
                        .Where(x => x.tariffData != null)
                        .SelectMany(x => x.tariffData!)
                        .ToList();
                }
            }
            else
            {
                Console.WriteLine($"Fout: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }

        StateHasChanged();
    }

    // Methode die word opgeroepen wanneer er een aanpassing is
    private void OnDateChanged(DateTime? date)
    {
        _selectedDate = date;
        GrafiekLaden();
    }

    // Methode die word opgeroepen wanneer er een aanpassing is
    private void OnAmountChanged()
    {
        if (wattAmount < 0)
        {
            wattAmount = 0;
        }
        UpdateLaadsessie();
    }

    // Methode die word opgeroepen wanneer er een aanpassing is
    private void OnPriceChanged(FocusEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(prijskWhText))
        {
            prijskWh = null;
            UpdateLaadsessie();
            return;
        }

        var normalized = prijskWhText.Replace(',', '.');

        if (decimal.TryParse(normalized, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out decimal value))
        {
            prijskWh = Math.Max(0, value);
        }
        prijskWhText = prijskWh?.ToString("0.##").Replace('.', ',') ?? "";

        UpdateLaadsessie();
    }

    // Methodie die de laadsessie berekent
    private void UpdateLaadsessie()
    {
        verbruiktAuto.Clear();
        verbruiktAutoDynamisch.Clear();
        laadSessies.Clear();
        DateTime? sessionStart = null;
        DateTime? sessionStop = null;

        if (measurements != null)
        {
            foreach (var measurement in measurements)
            {
                if (measurement != null && wattAmount.HasValue && measurement.Value > wattAmount.Value)
                {
                    if (sessionStart == null)
                    {
                        sessionStart = measurement.Timestamp;
                    }
                    // Hier word er berekent wat de kWh waarde is en wat de uurtarief prijs is
                    decimal kWh = Convert.ToDecimal(measurement.Value) / 60000m;
                    verbruiktAuto.Add(kWh);
                    if (UurTarieven != null){
                        var uurTarief = UurTarieven.FirstOrDefault(t => measurement.Timestamp >= t.startTime.ToLocalTime() && measurement.Timestamp < t.endTime.ToLocalTime());
                        if (uurTarief != null)
                        {
                            verbruiktAutoDynamisch.Add(uurTarief.amountInclVat * kWh);
                        }
                        else
                        {
                            verbruiktAutoDynamisch.Add(0m);
                        }
                    }
                }
                else if (sessionStart != null && measurement != null)
                {
                    sessionStop = measurement.Timestamp;
                    laadSessies.Add(new GebruikteData
                    {
                        StartTime = sessionStart.Value,
                        StopTime = sessionStop ?? sessionStart.Value,
                        Value = verbruiktAuto.Sum(),
                        Price = prijskWh ?? 0m,
                        TariffPrice = verbruiktAutoDynamisch.Sum()
                    });
                    sessionStart = null;
                    sessionStop = null;
                    verbruiktAutoDynamisch.Clear();
                    verbruiktAuto.Clear();
                }
            }
            // Als de sessie nog bezig is stopt die
            if (sessionStart != null)
            {
                laadSessies.Add(new GebruikteData
                {
                    StartTime = sessionStart.Value,
                    StopTime = sessionStop ?? sessionStart.Value,
                    Value = verbruiktAuto.Sum(),
                    Price = prijskWh ?? 0m,
                    TariffPrice = verbruiktAutoDynamisch.Sum()
                });
            }
        }
        StateHasChanged();
    }

    // Methode om de grafiek opnieuw te laden met nieuwe data
    private void GrafiekLaden()
    {
        if (_selectedDate == null)
            return;

        data.Clear();

        _xAxisLabels = Array.Empty<string>();

        int numberOfDays = (DateTime.Today - _selectedDate.Value.Date).Days + 1;

        measurements = measurementRepository.GetPower(smartMeterConfiguration.MeterId, numberOfDays, "1m");

        DateTime? lastLabeledTime = null;
        foreach (var measurement in measurements)
        {
            data.Add(Math.Round(measurement.Value, 1));

            var localTime = TimeZoneInfo.ConvertTimeFromUtc(
                measurement.Timestamp,
                TimeZoneInfo.FindSystemTimeZoneById("W. Europe Standard Time")
            );

            bool shouldLabel = false;

            if (lastLabeledTime == null || (localTime - lastLabeledTime.Value).TotalHours >= 1 * numberOfDays)
            {
                shouldLabel = true;
                lastLabeledTime = localTime;
            }

            _xAxisLabels = _xAxisLabels.Append(shouldLabel ? localTime.ToString("HH:mm") : "").ToArray();
        }

        _series = new List<ChartSeries>
    {
        new ChartSeries { Name = "Energie", Data = data.ToArray(), LineDisplayType = LineDisplayType.Area }
    };
        UpdateLaadsessie();
    }

}

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
