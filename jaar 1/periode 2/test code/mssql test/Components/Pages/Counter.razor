@page "/counter"
@rendermode InteractiveServer
@inject MsSqlTest.MsSqlService MsSqlService

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private int currentCount = 0;

    private async Task IncrementCount()
    {
        currentCount++;
        await IncrementInDatabase();
    }

    private async Task IncrementInDatabase(){
        await MsSqlService.ExecuteAsync($"INSERT INTO CounterLog (CountValue, LogDate) VALUES ({currentCount}, '{DateTime.Now:yyyy-MM-dd HH:mm:ss}')");
    }
}
