using TMPro;
using UnityEngine;

public class WorldEditorManager : MonoBehaviour
{
    public ScreenManager screenmanager;
    public TMP_Text selectedWorldLabel;
    public Transform parentCanvas;

    void Start()
    {
        if (screenmanager.selectedWorld != null)
        {
            selectedWorldLabel.text = screenmanager.selectedWorld.Name;
        }
        else
        {
            Debug.LogWarning("No world selected");
        }
    }

    public void Add2dObject(GameObject gameObject)
    {
        var newGameObject = Instantiate(gameObject, new Vector3(0, 0, 0), Quaternion.identity, parentCanvas);
        newGameObject.transform.SetAsLastSibling(); // Move to top in hierarchy
        var draggable = newGameObject.GetComponent<Draggable>();
        draggable.StartDragging();
    }
}